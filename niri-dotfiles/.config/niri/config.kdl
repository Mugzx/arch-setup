include "binds.kdl"
include "rule.kdl"
include "output.kdl"
include "colors.kdl"

// 截图保存位置
screenshot-path "~/Pictures/Screenshots/Niri-screenshots/%Y-%m-%d %H-%M-%S.png"

// 环境变量
environment {
    // 设置界面语言
    LC_MESSAGES "zh_CN.UTF-8"
    // 输入法环境变量
    XMODIFIERS "@im=fcitx"
    // qt主题
    QT_QPA_PLATFORMTHEME "qt6ct"
    // GTK软件使用的渲染器，可以解决n卡双显卡导致的GTK应用启动缓慢问题
    GSK_RENDERER "ql"
    // 默认文本编辑器
    EDITOR "vim"
}

// 光标配置
// 存放路径在~/.local/share/icons
cursor {
    // 主题
    xcursor-theme "Bibata-Modern-Ice"
    // 大小
    xcursor-size 19
    // 闲置多少毫秒自动隐藏光标
    hide-after-inactive-ms 15000
}
 
// 切换窗口（super/alt+tab选择带/不带缩略图）
recent-windows {
    // off
    debounce-ms 750
    open-delay-ms 150

    highlight {
        active-color "#999999ff"
        urgent-color "#ff9999ff"
        // 缩略图背景内间距
        padding 30
        // 缩略图的背景圆角
        corner-radius 12
    }

    previews {
        max-height 480
        max-scale 0.5
    }

    binds {
        // scope可以设置显示的窗口是当前工作区/显示器，或者显示全部窗口
        Mod+Tab         { next-window scope="workspace"; }
        Mod+Shift+Tab   { previous-window scope="workspace"; }
        // 波浪键 显示当前应用的所有窗口
        Mod+grave       { next-window filter="app-id"; }
        Mod+Shift+grave { previous-window filter="app-id"; }
    }
}

input {
    keyboard {
        xkb {
        // 留空默认使用系统的键盘布局
        // 此处可指定键盘规则、型号、布局、变体、选项等
        }

        // 启用数字锁定
        numlock
    }

    // libinput 设置
    touchpad {
        // off
        tap
        // dwt
        // dwtp
        // drag false
        // drag-lock
        // nautural-scroll可以翻转触摸板滚动的方向
        natural-scroll
        //accel-speed -0.5
        // accel-profile "flat"
        // scroll-method "two-finger"
        // disabled-on-external-mouse
    }

    mouse {
        // off
        // natural-scroll
        // 鼠标速度
        accel-speed -0.15
        // 禁用鼠标加速
        accel-profile "flat"
        // scroll-method "no-scroll"
        //speed of scroll,like:
        //scroll-factor horizontal=2.0 vertical=-5.0 
    }

    trackpoint {
        // off
        // natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "on-button-down"
        // scroll-button 273
        // scroll-button-lock
        // middle-emulation
    }

    // 使鼠标指针自动聚焦到新聚焦的窗口中心
    //warp-mouse-to-focus

    // 当鼠标移入窗口或输出时自动聚焦
    //focus-follows-mouse max-scroll-amount="50%"
}


layout {
    // 窗口和窗口之间的间距
    gaps 12
    //empty-workspace-above-first
    // "never"，焦点位于屏幕外的列将保持在屏幕左侧或右侧边缘
    // "always"，焦点列将始终居中
    // "on-overflow"，焦点列如果无法与先前焦点列一起显示，则会居中显示与先前聚焦的列一起居中
    center-focused-column "never"
    
    // 自定义 “switch-preset-column-width” (Mod+R) 切换的宽度
    // 预设窗口宽度
    preset-column-widths {
        // 默认预设宽度分别为输出宽度的 1/3、1/2 和 2/3。
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        // 以像素为单位
        //fixed 1920
    }
    // 自定义 "switch-preset-window-height" (Mod+Shift+R) 切换的高度
    // preset-window-heights { }

    // 新窗口的默认宽度，留空则由窗口决定
    default-column-width { proportion 0.5; }

    // CSD窗口形状不规则，默认焦点环和边框显示在窗口后方，透过半透明窗口显示。
    // 若不希望，可取消 `prefer-no-csd` 注释禁用 CSD 的窗口外部绘制边框。
    // 也可通过 draw-border-with-background 窗口规则调整。

    // 聚焦窗口边框外观（颜色设置在colors.kdl）
    focus-ring {
        // off
        // 焦点环向窗口外延伸的像素
        width 3

        // CSS语法
        // 活动显示器上的颜色
        //active-color "@primary"
        //active-color "#00000000"
        // Color of the ring on inactive monitors.

        // 非活动显示器上的颜色
        // 焦点环仅绘制在活动窗口周围，因此只能在其他显示器上看到此颜色
        //inactive-color "#505050"

        // 渐变（优先级高于纯色）
        // angle 可选，默认 180（从上到下渐变）
        //active-gradient from="#80c8ff" to="#c7ff7f" angle=45
        // 设置 relative-to="workspace-view" 可使渐变基于整个工作区视图
        //inactive-gradient from="#505050" to="#808080" angle=45 relative-to="workspace-view"
    }

    // 可以添加类似于对焦环的边框（始终可见）
    // 窗口边框
    border {
        off
        width 4
        active-color "#ffc87f"
        inactive-color "#505050"
        urgent-color "#9b0000"

        // 示例，可以使用oklch颜色空间的渐变
        // active-gradient from="#e5989b" to="#ffb4a2" angle=45 relative-to="workspace-view" in="oklch longer hue"
        // inactive-gradient from="#505050" to="#808080" angle=45 relative-to="workspace-view"
    }

    // 阴影
    shadow {
        on
        // 默认阴影绘制在窗口周围而非后方
        // 让阴影绘制在窗口后方，解决 CSD 圆角窗口的阴影显示问题
        //draw-behind-window true

        // 更改阴影的外观（值以逻辑像素为单位，与 CSS box-shadow 属性相匹配）
        // 阴影模糊半径
        softness 20
        // 扩大阴影范围
        spread 2
        // 阴影相对于窗口的位置
        offset x=-4 y=-4
        // 阴影颜色和不透明度
        color "rgba(0, 0, 0, 0.7)"
    }

    //窗口距离屏幕边缘的距离
    struts {
        //left 64
        //right 64
        //top 64
        //bottom 64
    }
}

// 自动启动设置
// 询问管理员权限功能（身份验证）
spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"
// 桌面壁纸的守护进程
spawn-at-startup "swww-daemon"
// 总览界面背景壁纸的守护进程
spawn-sh-at-startup "swww-daemon -n overview"
// 启动niri时ss随机更换一张壁纸
spawn-at-startup "waypaper" "--random"
// 有聚焦窗口时桌面自动模糊的脚本
spawn-at-startup "~/.config/scripts/niri_auto_blur_bg.sh"
// 屏幕分享、录屏相关的环境设置
spawn-sh-at-startup "dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=niri & /usr/lib/xdg-desktop-portal-gnome"
// GNOME tracker修复
spawn-sh-at-startup "systemctl --user set-environment XDG_SESSION_CLASS=user"
// 通知程序
spawn-at-startup "mako"
// 任务栏
spawn-at-startup "waybar"
// 输入法
spawn-at-startup "fcitx5"
// 剪贴板守护进程
spawn-sh-at-startup "copyq & disown"
// 闲置时自动熄屏锁屏休眠的脚本
spawn-at-startup "~/.config/niri/scripts/swayidle.sh"
// 大写锁定键的osd显示
spawn-at-startup "swayosd-server"
// alt+tab切换器（这是一个第三方，无缩略图显示的切换器）
spawn-at-startup "niriswitcher"

// 取消启动niri时自动开启快捷键教程
hotkey-overlay {
    skip-at-startup
}

// 隐藏窗口标题栏
prefer-no-csd
