// Introduction - niri:
// https://niri-wm.github.io/niri/Configuration:-Introduction
// 全局配置

include "binds.kdl"
include "rule.kdl"
include "output.kdl"
include "colors.kdl"
include "startup.kdl"

// 截图保存位置
screenshot-path "~/Pictures/Screenshots/niri/%Y-%m-%d %H-%M-%S.png"
// 隐藏窗口标题栏
prefer-no-csd

// 环境变量
environment {
    // 设置界面语言
    LC_MESSAGES "zh_CN.UTF-8"
    // 输入法环境变量
    XMODIFIERS "@im=fcitx"
    // qt主题
    QT_QPA_PLATFORMTHEME "qt6ct"
    // GTK软件使用的渲染器，可以解决n卡双显卡导致的GTK应用启动缓慢问题
    GSK_RENDERER "ql"
    // 默认文本编辑器
    EDITOR "vim"
}

// 光标配置
// 存放路径在~/.local/share/icons
cursor {
    // 主题
    xcursor-theme "Bibata-Modern-Ice"
    // 大小
    xcursor-size 19
    // 闲置多少毫秒自动隐藏光标
    hide-after-inactive-ms 15000
    // 打字时隐藏光标
    hide-when-typing
}
 
// 切换窗口
recent-windows {
    // off
    debounce-ms 750
    open-delay-ms 150

    highlight {
        // 缩略图背景内间距
        padding 30
        // 缩略图的背景圆角
        corner-radius 12
    }

    previews {
        max-height 480
        max-scale 0.5
    }
}

input {
    // 键盘设置
    keyboard {
        xkb {
        // 留空默认使用系统的键盘布局
        // 此处可指定键盘规则、型号、布局、变体、选项等
        }

        // 启用数字锁定
        numlock
    }

    // 触摸板设置
    touchpad {
        //off
        tap
        //dwt
        //dwtp
        //drag false
        //drag-lock
        //nautural-scroll可以翻转触摸板滚动的方向
        natural-scroll
        //accel-speed -0.5
        //accel-profile "flat"
        //scroll-method "two-finger"
        //disabled-on-external-mouse
    }

    // 鼠标设置
    mouse {
        // off
        // natural-scroll
        // 鼠标速度
        accel-speed -0.15
        // 禁用鼠标加速
        accel-profile "flat"
        // scroll-method "no-scroll"
        //speed of scroll,like:
        //scroll-factor horizontal=2.0 vertical=-5.0
    }

    // 「ThinkPad小红点」设置
    trackpoint {
        // off
        // natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "on-button-down"
        // scroll-button 273
        // scroll-button-lock
        // middle-emulation
    }

    // 使鼠标指针自动聚焦到新聚焦的窗口中心
    //warp-mouse-to-focus
    // 当鼠标移入窗口或输出时自动聚焦
    //focus-follows-mouse max-scroll-amount="50%"
    // 重复按同一个数字键回跳工作区
    //workspace-auto-back-and-forth
}

layout {
    // 窗口和窗口之间的间距
    gaps 12
    //center-focused-column "never"
    //default-column-display "tabbed"

    // 自定义 “switch-preset-column-width” (Mod+R) 切换的宽度
    preset-column-widths {
        proportion 0.3
    }
    // 自定义 "switch-preset-window-height" (Mod+Shift+R) 切换的高度
    preset-window-heights { proportion 0.75; }

    // 新窗口的默认宽度，留空则由窗口决定
    default-column-width { proportion 0.5; }
}

// 取消快捷键教程
hotkey-overlay {
    skip-at-startup
}
