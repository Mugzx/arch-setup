binds {

    // 显示快捷键教程
    Mod+Shift+Slash hotkey-overlay-title="快捷键教程" { show-hotkey-overlay; }

    // alt+tab切换窗口
    Alt+Tab  repeat=false { spawn "niriswitcherctl" "show" "--window"; }
    Mod+Alt+W  hotkey-overlay-title="切换壁纸" { spawn "waypaper"; }
    Mod+Alt+T  hotkey-overlay-title="切换颜色策略" { spawn "~/.config/scripts/matugen-select-type.sh"; }
    Mod+Alt+L  hotkey-overlay-title="锁屏" { spawn "swaylock"; }
    Mod+Alt+V hotkey-overlay-title="剪贴板" {spawn-sh "copyq toggle";}

    Mod+F1  hotkey-overlay-title="开关输入法" { spawn-sh "pkill fcitx5 || fcitx5 "; }
    Mod+F2  hotkey-overlay-title="顶部任务栏" { spawn-sh "pkill waybar & pkill cava || true && waybar -c $HOME/.config/waybar/config.jsonc -s $HOME/.config/waybar/style.css "; }
    Mod+F3  hotkey-overlay-title="底部任务栏" { spawn-sh "pkill waybar & pkill cava || true && waybar -c $HOME/.config/waybar-niri-Win11Like/config.jsonc -s $HOME/.config/waybar-niri-Win11Like/style.css "; }
    // 隐藏waybar，不关闭进程
    //Mod+F4  hotkey-overlay-title="隐藏waybar" { spawn-sh "killall -SIGUSR1 waybar"; }
    // 关闭waybar进程，释放资源占用
    Mod+F4  hotkey-overlay-title="开关任务栏" { spawn-sh "pkill waybar && pkill cava || waybar "; }
    Mod+F5  hotkey-overlay-title="快速存档" { spawn "~/.config/scripts/quicksave.sh"; }
    Mod+F10  hotkey-overlay-title="随机切换壁纸" { spawn "waypaper" "--random"; }

    // 快捷键打开应用
    Mod+B hotkey-overlay-title="浏览器" { spawn "chromium"; }
    Mod+E hotkey-overlay-title="文档管理器" { spawn-sh "env GSK_RENDERER=gl GTK_IM_MODULE=fcitx nautilus"; }
    Mod+T hotkey-overlay-title="终端" { spawn "kitty"; }
    Mod+Z hotkey-overlay-title="程序菜单" { spawn "fuzzel"; }
    Mod+P hotkey-overlay-title="选取屏幕颜色" { spawn-sh "hyprpicker | wl-copy"; }

    // 调节音量
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }

    // 调节屏幕亮度
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+5%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "5%-"; }

    // 切换聚焦，不限制上下切换窗口
    Mod+Left hotkey-overlay-title="向左切换窗口" { focus-column-left; }
    Mod+Down  { focus-window-or-workspace-down; }
    Mod+Up    { focus-window-or-workspace-up; }
    Mod+Right hotkey-overlay-title="向右切换窗口" { focus-column-right; }

    // 移动colume
    Mod+Ctrl+Left hotkey-overlay-title="向左移动窗口" { move-column-left; }
    // 这两处按键无反应，暂时禁用
    //Mod+Ctrl+Down  { move-window-down; }
    //Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Right hotkey-overlay-title="向右移动窗口" { move-column-right; }

    // 切换到第一/最后一个colume
    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    // 移动colume到第一/最后一个
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }

    // 此处为显示器之间的配置
    // 切换聚焦
    //Mod+Shift+Left  { focus-monitor-left; }
    //Mod+Shift+Down  { focus-monitor-down; }
    //Mod+Shift+Up    { focus-monitor-up; }
    //Mod+Shift+Right { focus-monitor-right; }
    // 移动colume
    //Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    //Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    //Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    //Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    // 移动整个工作区
    //Mod+Shift+Alt+Up     { move-workspace-to-monitor-up; }
    //Mod+Shift+Alt+Down   { move-workspace-to-monitor-down; }
    //Mod+Shift+Alt+Right  { move-workspace-to-monitor-right; }
    //Mod+Shift+Alt+Left   { move-workspace-to-monitor-left; }

    // 上下切换工作区
    Mod+U hotkey-overlay-title="向下切换窗口" { focus-workspace-down; }
    Mod+I hotkey-overlay-title="向上切换窗口" { focus-workspace-up; }
    Mod+Ctrl+U hotkey-overlay-title="向下移动窗口到其他工作区" { move-column-to-workspace-down; }
    Mod+Ctrl+I hotkey-overlay-title="向上移动窗口到其他工作区" { move-column-to-workspace-up; }

    // 滚轮 上下切换工作区
    Mod+Shift+WheelScrollDown hotkey-overlay-title="切换工作区" cooldown-ms=150 { focus-workspace-down; }
    Mod+Shift+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
    // 移动窗口
    Mod+Ctrl+Shift+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+Shift+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    // 滚轮左右切换聚焦
    Mod+WheelScrollDown   { focus-column-right; }
    Mod+WheelScrollUp     { focus-column-left; }
    // 移动colume
    Mod+Ctrl+WheelScrollDown { move-column-right; }
    Mod+Ctrl+WheelScrollUp   { move-column-left; }

    // 数字 切换工作区
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    // 移动colume
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }

    // mod+左右方括号 移动窗口
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    // 逗号/句号 把窗口合并或者踢出当前的colume
    Mod+Comma { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }
    // 开启colume的标签页模式
    Mod+Shift+X { toggle-column-tabbed-display; }
    Mod+X { toggle-column-tabbed-display; }
    // 鼠标侧键上下切换聚焦
    //Mod+MouseForward { focus-window-up; }
    //Mod+MouseBack    { focus-window-down; }

    // 按照预设切换窗口宽度
    Mod+R hotkey-overlay-title="按预设切换宽度" { switch-preset-column-width; }
    // 按照预设切换窗口高度
    Mod+Shift+R { switch-preset-window-height; }
    // 重置窗口高度
    Mod+Ctrl+R { reset-window-height; }


    // 增加窗口宽度占满空闲空间
    Mod+Ctrl+F { expand-column-to-available-width; }
    Mod+Alt+F hotkey-overlay-title="全屏" { fullscreen-window; }
    Mod+F hotkey-overlay-title="最大化" { maximize-column; }

    // 居中当前聚焦的colume
    Mod+C { center-column; }
    // 居中当前窗口位置
    Mod+Ctrl+C { center-visible-columns; }

    // 加减号 调整窗口宽度
    Mod+Minus { set-column-width "-5%"; }
    Mod+Equal { set-column-width "+5%"; }
    // 加减号 调整窗口高度
    Mod+Shift+Minus { set-window-height "-5%"; }
    Mod+Shift+Equal { set-window-height "+5%"; }

    // 浮动
    Mod+V hotkey-overlay-title="切换浮动" { toggle-window-floating; }
    // 在浮动模式和非浮动模式之间切换聚焦
    Mod+Shift+V hotkey-overlay-title="切换浮动聚焦" { switch-focus-between-floating-and-tiling; }

    // 截图
    Mod+Alt+A hotkey-overlay-title="选取区域截图" {screenshot;}
    Mod+Alt+Ctrl+A hotkey-overlay-title="截取聚焦窗口" { screenshot-window; }
    Mod+Alt+Ctrl+Shift+A hotkey-overlay-title="截取显示器" { screenshot-screen; }
    //Mod+Shift+S { spawn "~/.config/niri/scripts/satty-screenshot.sh";}
    Mod+Shift+S hotkey-overlay-title="截图后按下此键进行编辑" { spawn-sh "wl-paste | satty -f -";}

    // 其它
    // 鼠标中键 关闭窗口
    Mod+MouseMiddle { close-window; }
    Mod+Q hotkey-overlay-title="关闭聚焦窗口" repeat=false { close-window; }
    Mod+O hotkey-overlay-title="切换总览界面" repeat=false { toggle-overview; }
    Mod+Shift+Ctrl+Q hotkey-overlay-title="退出登录" { spawn "wlogout"; }
    Mod+Shift+E hotkey-overlay-title="退出 niri" { quit; }
    Ctrl+Alt+Delete hotkey-overlay-title="电源菜单" { spawn "wlogout"; }
    // Powers off the monitors. To turn them back on, do any input like
    // moving the mouse or pressing any other key.
    Mod+Shift+P hotkey-overlay-title="关闭显示器" { power-off-monitors; }

    // 避免问题软件劫持快捷键
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
}
