// Key Bindings - niri:
// https://niri-wm.github.io/niri/Configuration:-Key-Bindings

binds {
    // 显示快捷键教程
    Mod+Shift+Slash hotkey-overlay-title="Hotkey Tutorial" { show-hotkey-overlay; }

    Mod+Alt+W  hotkey-overlay-title="Switch Wallpaper" { spawn "waypaper"; }
    Mod+Alt+L  hotkey-overlay-title="Lock Screen" { spawn "swaylock"; }
    Mod+Alt+V hotkey-overlay-title="Clipboard" {spawn "kitty" "--class" "clipse" "-e" "clipse"; }

    Mod+F1  hotkey-overlay-title="Toggle Input Method" { spawn-sh "pkill fcitx5 || fcitx5 "; }
    Mod+F2  hotkey-overlay-title="Bottom Bar" { spawn-sh "pkill waybar & pkill cava || true && waybar"; }
    Mod+F3  hotkey-overlay-title="Quick Save" { spawn "~/.config/niri/scripts/quicksave.sh"; }
    Mod+F4  hotkey-overlay-title="Random Wallpaper" { spawn "waypaper" "--random"; }

    Mod+E hotkey-overlay-title="File Manager" { spawn-sh "env GSK_RENDERER=gl GTK_IM_MODULE=fcitx nautilus"; }
    Mod+T hotkey-overlay-title="Terminal" { spawn "kitty"; }
    Mod+Z hotkey-overlay-title="App Launcher" { spawn "fuzzel"; }
    Mod+P hotkey-overlay-title="Pick Screen Color" { spawn-sh "hyprpicker | wl-copy"; }

    // 浏览器
    Mod+B hotkey-overlay-title="Default Browser" { spawn "chromium"; }
    Mod+Alt+B { spawn "zen-browser"; }

    // 调节音量
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }

    // 调节屏幕亮度
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+5%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "5%-"; }

    // 切换聚焦，不限制上下切换窗口
    Mod+Left hotkey-overlay-title="Focus Window Left" { focus-column-left; }
    Mod+Down  { focus-window-or-workspace-down; }
    Mod+Up    { focus-window-or-workspace-up; }
    Mod+Right hotkey-overlay-title="Focus Window Right" { focus-column-right; }

    // 移动colume
    Mod+Ctrl+Left hotkey-overlay-title="Move Window Left" { move-column-left; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Right hotkey-overlay-title="Move Window Right" { move-column-right; }

    // 切换到第一/最后一个colume
    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    // 移动colume到第一/最后一个
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }

    // 此处为显示器之间的配置
    // 切换聚焦
    //Mod+Shift+Left  { focus-monitor-left; }
    //Mod+Shift+Down  { focus-monitor-down; }
    //Mod+Shift+Up    { focus-monitor-up; }
    //Mod+Shift+Right { focus-monitor-right; }
    // 移动colume
    //Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    //Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    //Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    //Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    // 移动整个工作区
    //Mod+Shift+Alt+Up     { move-workspace-to-monitor-up; }
    //Mod+Shift+Alt+Down   { move-workspace-to-monitor-down; }
    //Mod+Shift+Alt+Right  { move-workspace-to-monitor-right; }
    //Mod+Shift+Alt+Left   { move-workspace-to-monitor-left; }

    // 上下切换工作区
    Mod+U hotkey-overlay-title="Focus Workspace Down" { focus-workspace-down; }
    Mod+I hotkey-overlay-title="Focus Workspace Up" { focus-workspace-up; }
    Mod+Ctrl+U hotkey-overlay-title="Move Column to Workspace Down" { move-column-to-workspace-down; }
    Mod+Ctrl+I hotkey-overlay-title="Move Column to Workspace Up" { move-column-to-workspace-up; }

    // 滚轮
    // 上下切换工作区
    Mod+Shift+WheelScrollDown hotkey-overlay-title="Switch Workspace" cooldown-ms=150 { focus-workspace-down; }
    Mod+Shift+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
    // 移动窗口
    Mod+Ctrl+Shift+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+Shift+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }
    // 左右切换聚焦
    Mod+WheelScrollDown   { focus-column-right; }
    Mod+WheelScrollUp     { focus-column-left; }
    // 移动colume
    Mod+Ctrl+WheelScrollDown { move-column-right; }
    Mod+Ctrl+WheelScrollUp   { move-column-left; }

    // 数字 切换工作区
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    // 移动colume
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }

    // 左右方括号 移动窗口
    Mod+BracketLeft hotkey-overlay-title="Merge Left" { consume-or-expel-window-left; }
    Mod+BracketRight hotkey-overlay-title="Merge Right" { consume-or-expel-window-right; }

    // 逗号/句号 把窗口合并或者踢出当前的colume
    Mod+Comma { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }
    // 开启colume的标签页模式
    Mod+Shift+X { toggle-column-tabbed-display; }
    Mod+X { toggle-column-tabbed-display; }
    // 鼠标侧键 上下切换聚焦
    //Mod+MouseForward { focus-window-up; }
    //Mod+MouseBack    { focus-window-down; }

    // 按照预设切换窗口宽度
    Mod+R hotkey-overlay-title="Switch Preset Width" { switch-preset-column-width; }
    // 按照预设切换窗口高度
    Mod+Shift+R { switch-preset-window-height; }
    // 重置窗口高度
    Mod+Ctrl+R { reset-window-height; }


    // 增加窗口宽度占满空闲空间
    Mod+Ctrl+F { expand-column-to-available-width; }
    Mod+Alt+F hotkey-overlay-title="Fullscreen" { fullscreen-window; }
    Mod+F hotkey-overlay-title="Maximize" { maximize-column; }

    // 居中当前聚焦的colume
    Mod+C { center-column; }
    // 居中当前窗口位置
    Mod+Ctrl+C { center-visible-columns; }

    // 加减号
    // 调整窗口宽度
    Mod+Minus { set-column-width "-5%"; }
    Mod+Equal { set-column-width "+5%"; }
    // 调整窗口高度
    Mod+Shift+Minus { set-window-height "-5%"; }
    Mod+Shift+Equal { set-window-height "+5%"; }

    // 浮动
    Mod+V hotkey-overlay-title="Toggle Float" { toggle-window-floating; }
    // 在浮动模式和非浮动模式之间切换聚焦
    Mod+Shift+V hotkey-overlay-title="Toggle Float Focus" { switch-focus-between-floating-and-tiling; }

    // 截图
    Mod+Alt+A hotkey-overlay-title="Screenshot Area" { screenshot; }
    Mod+Alt+S hotkey-overlay-title="Screenshot Window" { screenshot-window; }
    Mod+Alt+D hotkey-overlay-title="Screenshot Screen" { screenshot-screen; }
    Mod+Shift+S hotkey-overlay-title="Edit Screenshot" { spawn-sh "wl-paste | satty -f -"; }

    // 其它
    // 鼠标中键 关闭窗口
    Mod+MouseMiddle { close-window; }
    Mod+Q hotkey-overlay-title="Close Focused Window" repeat=false { close-window; }
    Mod+O hotkey-overlay-title="Toggle Overview" repeat=false { toggle-overview; }
    Mod+Shift+E hotkey-overlay-title="Quit niri" { quit; }
    Ctrl+Alt+Delete hotkey-overlay-title="Power Menu" { spawn "wlogout"; }
    Mod+Shift+P hotkey-overlay-title="Power Off Monitors" { power-off-monitors; }

    // 避免问题软件劫持快捷键
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
}

// 切换窗口 可以选择上/下一个窗口
recent-windows {
    binds {
        Mod+Tab { next-window scope="workspace"; }
        Mod+Shift+Tab { previous-window scope="workspace"; }
        Alt+Tab { next-window scope="all"; }
        Alt+Shift+Tab { previous-window scope="all"; }
    }
}
