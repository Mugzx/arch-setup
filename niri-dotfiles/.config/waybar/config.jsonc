// Docs: https://github.com/Alexays/Waybar/wiki/Configuration
{
    // 这个waybar因为大该过一次布局，所以箭头已经的位置和名字已经完全对不上了，从左到右看吧。
    // TODO: 重新调整箭头命名
    "include": [
        "modules.jsonc",
        "modules-dividers.jsonc"
    ],
    // 窗口层级
    "layer":"top",
    // 屏幕位置
    "position": "bottom",
    "fixed-center": true,
    //"height": 30,
    //"output": "DP-2",
    "reload_style_on_change": true,
    "modules-left": [
        "niri/workspaces",
        "custom/right_div#5",
        //"cffi/niri-taskbar",
        "custom/right_div#4",
        "custom/cava",
        //"mpris",
        "custom/right_div#7",
        "niri/window",
        "custom/right_div#6"
    ],
    "modules-center": [
        "custom/left_div#3",
        "custom/recorder",
        //"privacy",
        "custom/screenshot",
        "custom/left_div#2",
        "idle_inhibitor",
        "custom/colorpicker",
        "power-profiles-daemon",
        "custom/left_div#8",
        "custom/left_div#1",
        "custom/applauncher",
        "custom/right_div#1",
        "custom/right_div#8",
        "clock",
        "custom/right_div#2",
        //"clock#date",
        "bluetooth",
        "network",
        "custom/right_div#3"
    ],
    "modules-right": [
        "custom/left_div#6",
        "custom/updates",
        "tray",
        "custom/left_div#4",
        "group/ddcutil",
        "group/audio",
        "custom/left_div#7",
        "battery",
        "custom/left_div#5",
        "group/powermenu"
    ]
}
