{
  // 工作区 窗口名称
  "niri/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "active": "󰜋",
      "default": ""
    },
    "ignore-hidden": true
  },

  "cffi/niri-taskbar": {
    // module_path
    "module_path": "/usr/lib/waybar/libniri_taskbar.so",
    "apps": {
      "signal": [
        {
          "match": "\\([0-9]+\\)$",
          "class": "unread"
        }
      ]
    }
  },

  "cpu": {
    "interval": 5,
    "format": " {usage}%",
    "min-length": 7,
    "max-length": 7
  },

  // 音频可视化
  "custom/cava": {
    "tooltip": false,
    //"tooltip-format": "左键：播放/暂停",
    "format": "{}",
    "exec": "~/.config/waybar/scripts/cava.sh",
    "on-click": "playerctl play-pause"
  },

  "memory": {
    "interval": 5,
    "format": " {percentage}%",
    "min-length": 7,
    "max-length": 7,
    "tooltip-format": "内存用量：{used:0.1f}/{total:0.1f} GB"
  },

  "niri/window": {
    "format": "{}",
    "rewrite": {}
  },

  // 上传/下载模块
  "network#upload": {
  "interval": 2,
  "format": " {bandwidthUpBytes}",
  "tooltip": false
  },

  "network#download": {
    "interval": 2,
    "format": " {bandwidthDownBytes}",
    "tooltip": false
  }
}
